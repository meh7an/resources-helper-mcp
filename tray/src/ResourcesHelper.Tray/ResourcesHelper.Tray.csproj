<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ResourcesHelper.Tray</RootNamespace>
    <AssemblyName>rh-tray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- LibraryImport generates unsafe marshalling code for Interop/NativeMethods.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs owns Main so a second launch can hand off before any XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <!-- Handoff tray icons; LoadImage picks the frame for the DPI straight from these files. -->
    <Content Include="Assets\Tray\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ResourcesHelper.Tray.Core\ResourcesHelper.Tray.Core.csproj" />
  </ItemGroup>

  <!--
    Windows App SDK 2.5.1 bug (microsoft/WindowsAppSDK#6774): a self-contained build lacks
    Microsoft.WindowsAppRuntime.Insights.Resource.dll, so AppNotificationManager.Register throws
    0x8007007E. The DLL ships only inside the runtime MSIX; copy it next to the exe. Delete this
    block once a release with the fix ships; the Error fires when the SDK version moves.
  -->
  <PropertyGroup>
    <InsightsResourceDll>Microsoft.WindowsAppRuntime.Insights.Resource.dll</InsightsResourceDll>
    <InsightsResourceMsix>$(NuGetPackageRoot)microsoft.windowsappsdk.runtime\2.5.1\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix</InsightsResourceMsix>
  </PropertyGroup>

  <Target Name="AddInsightsResource" BeforeTargets="AssignTargetPaths">
    <Error
      Condition="!Exists('$(InsightsResourceMsix)')"
      Text="$(InsightsResourceMsix) is missing. If the Windows App SDK was bumped, check whether #6774 is fixed and drop this workaround, or update the path." />
    <Unzip
      SourceFiles="$(InsightsResourceMsix)"
      DestinationFolder="$(IntermediateOutputPath)insights"
      Include="$(InsightsResourceDll)"
      SkipUnchangedFiles="true" />
    <ItemGroup>
      <None
        Include="$(IntermediateOutputPath)insights\$(InsightsResourceDll)"
        Link="$(InsightsResourceDll)"
        CopyToOutputDirectory="PreserveNewest"
        CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>